---
interface Props { primary?: boolean; }
const { primary = false } = Astro.props;
const Heading = primary ? "h1" : "h2";
---

<div class="gateway-field capital-field" id="capital" data-section="capital" data-primary={primary ? "true" : "false"}>
  <div class="coordinate" aria-hidden="true">22°54′15″S<br />43°12′39″W</div>
  <div class="field-copy" data-reveal>
    <p class="eyebrow blue">Capital</p>
    <Heading>Capital para<br />o que precisa<br />durar<span class="blue">.</span></Heading>
    <p class="lead">Risco visível. Recurso rastreável.<br />Impacto verificável.</p>
  </div>

  <div class="capital-flow" data-reveal>
    <p class="micro-title blue">Fluxo correto</p>
    <ol>
      <li><span>01</span><strong>Capital</strong><small>propósito claro</small></li>
      <li><span>02</span><strong>Protocolo</strong><small>regras explícitas</small></li>
      <li><span>03</span><strong>Hifas</strong><small>alocação localizada</small></li>
      <li><span>04</span><strong>Valor</strong><small>evidência verificável</small></li>
    </ol>
  </div>

  <div class="evidence" data-reveal>
    <p class="micro-title blue">Evidência &amp; gates</p>
    <div class="evidence-grid">
      <article><b>01</b><strong>Alocação diligente</strong><p>Recursos chegam com propósito e responsabilidades claros.</p></article>
      <article><b>02</b><strong>Fluxo rastreável</strong><p>Entradas, alocações e destinos dos recursos.</p></article>
      <article><b>03</b><strong>Impacto verificável</strong><p>Evidência, aprendizado e novos ciclos.</p></article>
    </div>
  </div>
  <a class="cta cta-blue" href="#tese-capital" data-reveal><span>Conhecer a tese</span><i>Capital de impacto + liquidez onchain</i></a>
</div>
