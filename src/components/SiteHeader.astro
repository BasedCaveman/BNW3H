---
interface Props {
  active?: "hifas" | "capital";
}

const { active = "hifas" } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Bossa Nova Web3 Hub, página inicial">
    <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="brand-name">BOSSA NOVA<sup>3</sup></span>
    <span class="brand-tag">WEB3 HUB</span>
  </a>

  <nav aria-label="Escolha sua porta de entrada">
    <a href="/" aria-current={active === "hifas" ? "page" : undefined}>Chegar junto</a>
    <a href="/capital" aria-current={active === "capital" ? "page" : undefined}>Ativar capital</a>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    width: min(100% - 2rem, 80rem);
    margin-inline: auto;
    padding-block: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: grid;
    grid-template-columns: 2rem auto;
    align-items: center;
    column-gap: 0.7rem;
    text-decoration: none;
  }

  .brand-mark {
    grid-row: 1 / 3;
    width: 2rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    position: relative;
  }

  .brand-mark i {
    position: absolute;
    width: 100%;
    height: 1px;
    background: #d9ff6b;
    transform-origin: center;
  }

  .brand-mark i:nth-child(1) { transform: rotate(0deg); }
  .brand-mark i:nth-child(2) { transform: rotate(60deg); }
  .brand-mark i:nth-child(3) { transform: rotate(120deg); }

  .brand-name {
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.12em;
  }

  .brand-name sup {
    color: #d9ff6b;
  }

  .brand-tag {
    margin-top: 0.18rem;
    color: #9eaaa3;
    font-size: 0.58rem;
    letter-spacing: 0.24em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid #ffffff1a;
    border-radius: 999px;
    background: #ffffff08;
  }

  nav a {
    min-height: 2.5rem;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    color: #a8b3ad;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav a[aria-current="page"] {
    background: #f1ecdf;
    color: #07120f;
  }

  @media (max-width: 42rem) {
    .site-header {
      align-items: flex-start;
    }

    .brand-tag {
      display: none;
    }

    nav a {
      padding-inline: 0.75rem;
      font-size: 0.7rem;
    }
  }

  @media (max-width: 25rem) {
    .brand-name {
      max-width: 6rem;
      line-height: 1.15;
    }

    nav {
      flex-direction: column;
      border-radius: 1rem;
    }
  }
</style>
